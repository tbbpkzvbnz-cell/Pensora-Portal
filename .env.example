# --- Datenbank ---
DATABASE_URL=postgres://pensora:pensora@localhost:5432/pensora

# Öffentliche Basis-URL (für Erfassungslinks und Passwort-Reset)
APP_URL=http://localhost:3000

# 32 Byte, base64. Erzeugen: openssl rand -base64 32
# Schlüssel für die Verschlüsselung der Dokumente (AES-256-GCM). NIE ändern ohne Re-Encryption!
DOCUMENT_ENCRYPTION_KEY=

# --- Dokumentspeicher: local | s3 ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
# S3-kompatibel (Supabase Storage, Exoscale, Infomaniak ...)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- SMS: twilio | aspsms | dev-log (nur Entwicklung) | leer = nicht aktiv ---
SMS_PROVIDER=
SMS_SENDER=Pensora
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ASPSMS_USER_KEY=
ASPSMS_PASSWORD=

# --- E-Mail (Pensora-Geschäftspostfach) via SMTP | leer = nicht aktiv ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
